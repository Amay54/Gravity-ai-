# Use standard Python 3.12 slim image
FROM python:3.12-slim AS builder

# Set runtime environment parameters
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local

# Install system dependencies (build-essential needed for any C-based libraries)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:0.2.10 /uv /bin/uv

# Set working directory
WORKDIR /app

# Copy dependency definition configurations
COPY pyproject.toml uv.lock ./

# Install project dependencies globally in the container
RUN uv pip install --system --no-cache -r pyproject.toml

# ==============================================================================
# Production Stage
# ==============================================================================
FROM python:3.12-slim AS runner

WORKDIR /app

# Copy installed site-packages and system binaries from builder
COPY --from=builder /usr/local /usr/local

# Copy backend codebase
COPY ./backend /app/backend

# Create a non-privileged user and switch to it for secure runtime execution
RUN useradd -u 10001 -m appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check setup
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/system/health || exit 1

# Execute FastAPI via Uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
